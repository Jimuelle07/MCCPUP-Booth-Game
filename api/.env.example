# Azure AD B2C tenant backing the admin auth. Verification is just JWKS
# signature checking, so no Azure SDK or service credential is needed here
# -- these three values are enough, locally or in Azure Container Apps.
AZURE_B2C_TENANT_NAME=
AZURE_B2C_CLIENT_ID=
AZURE_B2C_SIGNIN_POLICY=B2C_1_susi

# Comma-separated bootstrap allow-list of admin emails. Example:
# ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=
