# GCP project backing the admin auth (Firebase Authentication /
# Identity Platform). On Cloud Run this + Application Default Credentials
# are picked up automatically; set it explicitly for local dev.
FIREBASE_PROJECT_ID=

# Comma-separated bootstrap allow-list of admin emails. Grants dashboard
# access before anyone has the `admin` custom claim set. Example:
# ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# Local dev only: path to a service-account JSON key with the
# "Firebase Authentication Admin" role. Leave unset on Cloud Run —
# Application Default Credentials cover it there.
GOOGLE_APPLICATION_CREDENTIALS=
