# Azure AD B2C (Microsoft Entra External ID) config for the /admin login,
# sign up, and forgot-password pages. Get these from the Azure portal:
# your B2C tenant > App registrations > your SPA app.
# Safe to expose to the browser (they identify the app, not a secret) --
# the SPA app registration uses PKCE, no client secret involved.
VITE_AZURE_B2C_TENANT_NAME=
VITE_AZURE_B2C_CLIENT_ID=

# User flow (policy) names from B2C > User flows. Defaults match the names
# Azure suggests when you create them from the portal's templates.
VITE_AZURE_B2C_SIGNIN_POLICY=B2C_1_susi
VITE_AZURE_B2C_RESET_POLICY=B2C_1_reset

# Must be registered as a Redirect URI on the SPA app registration.
# Defaults to "<this site>/admin/dashboard" if unset.
VITE_AZURE_B2C_REDIRECT_URI=
