# GCP Identity Platform (Firebase Authentication) web client config, used by
# the /admin login, sign up, and forgot-password pages. Get these values
# from the Firebase console: Project settings > General > Your apps > Web app.
# Safe to expose to the browser (they identify the project, not a secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
